    },
    "Skill": {
      "label": "Skill",
      "parent": "Capability",
      "note": "一段可加载的工作说明"
    },
    "Boundary": {
      "label": "边界",
      "parent": "Thing",
      "note": "一条约束；关键是看它 enforced_by 什么"
    },
    "Project": {
      "label": "研究项目",
      "parent": "Thing"
    },
    "KnowledgeNode": {
      "label": "知识节点",
      "parent": "Thing",
      "note": "来自博客「Agent 学习本体」"
    },
    "Concept": {
      "label": "概念",
      "parent": "KnowledgeNode"
    },
    "Pattern": {
      "label": "设计模式",
