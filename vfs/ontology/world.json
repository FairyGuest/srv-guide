      "id": "m-tools",
      "class": "Mechanism",
      "label": "tools.mjs 只实现读操作",
      "summary": "工具执行器里根本没有写文件、执行命令或发网络请求（本机健康检查除外）的代码路径。"
    },
    {
      "id": "m-vfs",
      "class": "Mechanism",
      "label": "内存虚拟文件系统",
      "summary": "启动时把公开资料读进内存，路径解析最多退到虚拟根目录，碰不到真实磁盘。"
    },
    {
      "id": "m-shell",
      "class": "Mechanism",
      "label": "shell.mjs 沙盒",
      "summary": "! 命令全部用 JS 模拟；含 | ; & > < $ 反引号的输入直接拒绝。"
    },
    {
      "id": "m-systemd",
      "class": "Mechanism",
      "label": "systemd 沙箱",
      "summary": "每个 Node 后端都以 deploy 用户运行：NoNewPrivileges、ProtectSystem=strict、ProtectHome，ReadWritePaths 只放行自己的数据目录，再加 MemoryMax / CPUQuota 上限（server-guide 256M，market-watch 192M）。"
    },
    {
      "id": "m-bind",
      "class": "Mechanism",
      "label": "只绑定 127.0.0.1",
      "summary": "后端 HOST=127.0.0.1，公网只能经过 Nginx。可用 Ports 工具实测。"
    },
    {
      "id": "m-nginx",
      "class": "Mechanism",
      "label": "Nginx 限流与 CSP",
      "summary": "personal_api 限流区、请求体 32k 上限、CSP default-src 'self'。"
    },
    {
      "id": "m-quota",
      "class": "Mechanism",
      "label": "server.mjs 额度与限长",
