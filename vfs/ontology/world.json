    "SoftwareAgent": {
      "label": "软件 Agent",
      "parent": "Agent"
    },
    "Artifact": {
      "label": "人造物",
      "parent": "Thing"
    },
    "Machine": {
      "label": "机器",
      "parent": "Artifact"
    },
    "Service": {
      "label": "服务",
      "parent": "Artifact",
      "note": "一个长期运行的进程或定时任务"
    },
    "Endpoint": {
      "label": "端点",
      "parent": "Artifact",
      "note": "监听地址:端口，或一个 URL 路径"
    },
    "Page": {
      "label": "页面",
      "parent": "Artifact",
      "note": "已发布到网站的公开页面"
    },
    "Mechanism": {
      "label": "机制",
      "parent": "Artifact",
      "note": "真正执行约束的代码或配置"
    },
    "Capability": {
      "label": "能力",
      "parent": "Artifact"
    },
    "Tool": {
      "label": "工具",
      "parent": "Capability",
