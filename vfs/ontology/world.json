      "class": "Boundary",
      "label": "工具输出是数据不是指令",
      "summary": "即使页面里藏了指令也不照做。提示词负责引导；就算被注入，程序里也没有可用的写操作。"
    },
    {
      "id": "b-no-fabrication",
      "class": "Boundary",
      "label": "不编造主人信息",
      "summary": "只谈公开资料。这一条目前只由提示词约束，是软约束；依据行能让读者自己核对。"
    },
    {
      "id": "market-watch",
      "class": "Service",
      "label": "market-watch",
      "aliases": [
        "盯盘",
        "盯盘 Agent",
        "复盘墙"
      ],
      "summary": "盯盘 Agent 的后端：每个交易日收盘后拉行情和快讯，让多头、空头、风控三个 Agent 辩论并给出次日和 5 日判断，之后用真实走势自动对账。对外只读，访客触发不了模型调用。",
      "url": "/lab/market/",
      "observe": [
        "ServiceHealth"
      ],
      "unit": "market-watch",
      "health": "http://127.0.0.1:3004/health"
    },
    {
      "id": "tat-agent",
      "class": "Service",
      "label": "tat_agent",
      "short": "腾讯云助手",
      "summary": "腾讯云自动化助手（TAT），云控制台远程执行命令用。以 root 运行，不受 deploy 用户的边界约束，是主人自己的备用管理通道。",
      "unit": "tat_agent"
    },
    {
      "id": "ep-3004",
      "class": "Endpoint",
      "label": "127.0.0.1:3004",
      "summary": "market-watch，只监听本机。",
      "observe": [
        "Ports"
      ],
      "port": 3004,
      "scope": "loopback"
    },
    {
      "id": "route-api-market",
      "class": "Endpoint",
      "label": "/api/market/",
      "summary": "Nginx 把它转发给 market-watch，只放行 GET（limit_except GET），共享 personal_api 限流区。",
      "path": "/api/market/"
    },
    {
      "id": "ds-www",
      "class": "DataStore",
      "label": "已发布网站",
      "summary": "静态站点的线上目录。只有推送即部署会整站同步它；Nginx 和 server-guide 只读。",
      "path": "/srv/www/personal"
    },
    {
      "id": "ds-demo",
      "class": "DataStore",
      "label": "示例数据",
      "summary": "personal-demo 的数据目录（目前是空的）。",
      "path": "/srv/data/demo"
    },
    {
      "id": "ds-guide",
      "class": "DataStore",
      "label": "导游数据",
      "summary": "每日额度、对话日志（IP 只存加盐哈希）、模型 Key，以及部署流水线留下的上线记录和漂移报告。",
      "path": "/srv/data/server-guide"
    },
    {
      "id": "ds-market",
      "class": "DataStore",
      "label": "盯盘数据",
      "summary": "每天的行情快照、三方辩论、判断和对账结果，以及 token 用量。",
      "path": "/srv/data/market-watch"
    },
    {
      "id": "ext-deepseek",
      "class": "ExternalService",
      "label": "DeepSeek API",
      "summary": "大模型接口（Anthropic 兼容协议）。导游回答问题、盯盘辩论都调用它；Key 只在服务器的 guide.env 里。",
      "host": "api.deepseek.com"
    },
    {
      "id": "ext-eastmoney",
      "class": "ExternalService",
      "label": "东方财富",
      "summary": "日 K 行情和 7×24 快讯的公开接口，盯盘每个交易日收盘后读一次。只发请求参数，不发任何本站数据。",
      "host": "eastmoney.com"
    },
    {
      "id": "ext-letsencrypt",
      "class": "ExternalService",
      "label": "Let's Encrypt",
      "summary": "签发这台服务器 IP 证书的 CA；certbot 续期时调用。",
      "host": "acme-v02.api.letsencrypt.org"
    },
    {
      "id": "push-deploy",
      "class": "Pipeline",
      "label": "推送即部署",
      "aliases": [
        "git push",
        "部署流水线",
        "release.sh"
      ],
      "summary": "主人 git push 到服务器上的裸仓库后，pre-receive 跑测试和构建，post-receive 备份、同步静态站、按需同步后端并重启、做健康检查，失败自动回滚。全程以 deploy 用户运行。"
    },
    {
      "id": "m-market-api",
      "class": "Mechanism",
      "label": "market-watch 只有 GET 路由",
      "summary": "server.mjs 只实现 GET；Nginx 对 /api/market/ 加了 limit_except GET。辩论只由服务内部的收盘定时器触发。"
    },
    {
      "id": "m-token-budget",
      "class": "Mechanism",
      "label": "market-watch 每日 token 上限",
      "summary": "每次调用前检查当天用量，超过 MARKET_DAILY_TOKENS 就停下，只记录行情和基线。"
    },
    {
      "id": "m-sudoers",
      "class": "Mechanism",
      "label": "sudoers 只放行重启",
      "summary": "/etc/sudoers.d/deploy-restart：deploy 只能 systemctl restart 四个后端，别的 sudo 都不行。"
    },
    {
      "id": "m-precheck",
      "class": "Mechanism",
      "label": "pre-receive 测试",
      "summary": "博客构建器和各后端的测试不过，推送直接被拒绝，服务器上的 main 不会前进。"
    },
    {
      "id": "m-rollback",
      "class": "Mechanism",
      "label": "健康检查与回滚",
      "summary": "重启后 10 秒内 /health 不通，或公网路径不是 200，就恢复备份的旧版本。"
    },
    {
      "id": "b-no-visitor-llm",
      "class": "Boundary",
      "label": "访客触发不了盯盘的模型调用",
      "summary": "复盘墙只读，所有判断都是收盘后服务自己跑出来的。"
    },
    {
      "id": "b-token-budget",
      "class": "Boundary",
      "label": "盯盘每日 token 预算",
      "summary": "默认每天 40 万 token，超了当天就不再辩论。"
    },
    {
      "id": "b-write-scope",
      "class": "Boundary",
      "label": "只能写自己的数据目录",
      "summary": "后端进程看到的整个文件系统都是只读的，只有 ReadWritePaths 里登记的目录可写。"
    },
    {
      "id": "b-deploy-least",
      "class": "Boundary",
      "label": "部署用户最小权限",
      "summary": "推送能改网站和后端代码、能重启后端；改 systemd 单元、Nginx 配置、sudo 规则仍然需要 root 手动执行。"
    },
    {
      "id": "b-verified-release",
      "class": "Boundary",
      "label": "坏版本上不了线",
      "summary": "测试不过不收，上线后健康检查不过就回滚。"
    },
    {
      "id": "knock-timer",
      "class": "Service",
      "label": "server-knock.timer",
      "summary": "每小时读一次 Nginx 和 SSH 日志，把扫描器、爆破这些不请自来的敲门按天数成类别和次数；IP 只在内存里去重，一个都不落盘。",
      "observe": [
        "ServiceHealth"
      ],
      "unit": "server-knock.timer",
      "short": "敲门声采集",
      "url": "/lab/knock/"
    },
    {
      "id": "ds-logs",
      "class": "DataStore",
      "label": "Nginx / SSH 日志",
      "summary": "/var/log/nginx 的访问日志和 /var/log/secure，属于 root；只有敲门声采集靠一个只读能力看得到。",
      "path": "/var/log"
    },
    {
      "id": "ds-knock",
      "class": "DataStore",
      "label": "敲门声数据",
      "summary": "knock.json：最近 120 天每天的敲门总数、类别、时段、客户端家族和少量白名单样本，不含 IP。",
      "path": "/srv/data/knock"
    },
    {
      "id": "m-knock",
      "class": "Mechanism",
      "label": "knock.mjs 只存计数",
      "summary": "IP 只用来在内存里数“多少个来源”；样本只取识别出类别的路径并过一遍字符白名单；本机账号名、登录成功过的来源、不公开的路径都不计入。"
    },
    {
      "id": "b-no-ip",
      "class": "Boundary",
      "label": "敲门声不留 IP",
      "summary": "公开的只有按天汇总的次数和类别，磁盘上也不存任何来源地址。"
    }
  ],
